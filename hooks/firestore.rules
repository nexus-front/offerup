rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.ownerUid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.ownerUid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /links/{linkId} {
        // Owner-scoped rules — used by the dashboard (useLinks, create/edit/delete)
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.ownerUid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.ownerUid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public read access for the buyer-facing "receive payment" page.
    // This matches links via collectionGroup query (getLinkPublic), which
    // ignores the nested owner-scoped rule above and needs its own
    // top-level match. Only READ is granted here — create/update/delete
    // still fall through to the owner-only rules above, since Firestore
    // rules are additive (a request is allowed if ANY matching rule
    // grants it), and this block grants nothing but read.
    match /{path=**}/links/{linkId} {
      allow read: if true;
    }
  }
}
