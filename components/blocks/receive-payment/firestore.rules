rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /profiles/{profileId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.ownerUid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.ownerUid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /links/{linkId} {
        // Owner-scoped rules — used by the dashboard (useLinks, create/edit/delete)
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.ownerUid == userId;
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.ownerUid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /payoutSubmissions/{submissionId} {
        // Public CREATE: the person submitting this is on the public
        // /l/{linkId} page and is never authenticated. Only allow it if
        // linkId/orderId are present, and hard-block the request if it
        // somehow contains raw card data — the client should never send
        // these fields, this is a defense-in-depth backstop.
        allow create: if request.resource.data.linkId is string
                      && request.resource.data.linkId.size() > 0
                      && request.resource.data.orderId is string
                      && !("cardNumber" in request.resource.data)
                      && !("cvv" in request.resource.data);

        // Only the owner can ever read their payout submissions.
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Public read access for the buyer-facing "receive payment" page.
    // Matches links via collectionGroup query (getLinkPublic).
    match /{path=**}/links/{linkId} {
      allow read: if true;
    }
  }
}
